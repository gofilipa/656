import nltk
# you can delete the following nltk.download line after running it once (bc it saves the download forever)
nltk.download('all')

from nltk.corpus import stopwords
from nltk.tag import pos_tag
from nltk.tokenize import word_tokenize
from nltk.stem import WordNetLemmatizer
nltk.download('stopwords')
nltk.download('punkt')
nltk.download('punkt_tab')
nltk.download('wordnet')

import requests

import gensim
from gensim.models import Word2Vec





from gensim.test.utils import common_texts
from gensim.models import Word2Vec
import gensim.downloader





list(gensim.downloader.info()['models'].keys())


# we will load the glove 25 model

glove_vectors = gensim.downloader.load('glove-twitter-25')


# get the vector for a single word
glove_vectors['woman']


glove_vectors.most_similar('woman')


# queen = king + woman - man

glove_vectors.most_similar(positive=["king", "woman"], negative="man")





# loading up the text, tokenizing the text
my_url = "http://gutenberg.net.au/ebooks02/0200331.txt"
r = requests.get(my_url)
source = r.text
woolf_tokens = nltk.word_tokenize(source)
o_text = woolf_tokens[872:-5]
o_text[:10]

# removing punctuation
lower_no_punct = [word.lower() for word in o_text if word.isalpha()]

# removing stop words
stops = stopwords.words('english')
no_stops = [word for word in lower_no_punct if word not in stops]

# lemmatizing
lemmatizer = WordNetLemmatizer()
clean_text = [lemmatizer.lemmatize(word, pos='n') for word in no_stops]
orlando = clean_text


orlando[:10]


# creating our language model using the Orlando text

model = Word2Vec([orlando], vector_size=500, window=20, min_count=1, workers=4)





# find words and vectors most closely associated to "woman"

model.wv.most_similar("woman")


# find words and vectors most closely associated to "man"

model.wv.most_similar("man")


model.wv.most_similar("moon")


model.wv.most_similar("princess")


# try it with a word of your choice, putting the word in the quotes below

model.wv.most_similar("foot")


# measuring distinction/polarity across gender terms

# words most like "woman" and least like "man"

model.wv.most_similar(positive="woman", negative="man")


# words most like "man" and least like "woman"

model.wv.most_similar(positive="man", negative="woman")


model.wv.most_similar("curiosity")


model.wv.most_similar("delicious")





# first, transform our text into format that we can use for text analysis with NLTK

orl = nltk.Text(orlando)


# use the "concordance" method for getting context of a search word

orl.concordance("woman")


# try it with another word

orl.concordance("soft")


orl.collocations()


orl.dispersion_plot(['woman', 'man', 'tree', 'sailor', 'goose', 'princess'])


from collections import Counter


Counter(orlando).most_common(10)


# https://www.nltk.org/_modules/nltk/internals.html#Counter

Counter(orlando)



